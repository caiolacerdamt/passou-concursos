# Comparador de vozes (TTS) — preencha SÓ as chaves que voce quiser testar.
# O script pula automaticamente os provedores sem chave. Copie este arquivo para .env:
#   cp .env.example .env   (PowerShell/Git Bash aceitam)

# Quantas explicacoes usar na estimativa de custo (opcional)
ESTIMATE_EXPLICACOES=5000

# --- ElevenLabs --- https://elevenlabs.io  (gratis ~10 mil caracteres/mes)
# Chave: https://elevenlabs.io/app/settings/api-keys
# Voz: na aba Voices, escolha/adicione uma voz PT-BR (Brasil) e copie o Voice ID
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_v3 = modelo mais novo (fev/2026), ideal para audio pre-gravado. Alternativa: eleven_multilingual_v2
ELEVENLABS_MODEL_ID=eleven_v3

# --- Google Cloud Text-to-Speech --- Chirp 3 HD (gratis 1 milhao de caracteres/mes)
# Habilite a API "Cloud Text-to-Speech" no projeto e crie uma API key
# Vozes pt-BR Chirp 3 HD: pt-BR-Chirp3-HD-Aoede | -Kore | -Leda | -Zephyr | -Puck | -Charon | -Fenrir | -Orus
GOOGLE_API_KEY=
GOOGLE_VOICE=pt-BR-Chirp3-HD-Aoede

# --- OpenAI --- https://platform.openai.com  (sem free tier; pago e baixissimo)
# Vozes: coral, nova, marin, cedar, alloy, ash, ballad, echo, fable, onyx, sage, shimmer, verse
OPENAI_API_KEY=
OPENAI_VOICE=coral
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- Fish Audio --- https://fish.audio  (n1 em ranking de qualidade 2026; tem trial)
# Chave: https://fish.audio/app/api-keys
# Voz: escolha uma voz PT-BR no site e copie o "reference_id" (Model ID da voz)
FISH_API_KEY=
FISH_REFERENCE_ID=
# s2.1-pro = modelo mais novo/melhor (nº1 em teste cego 2026). Use s2.1-pro-free para avaliar
FISH_MODEL=s2.1-pro-free

# --- Microsoft Azure Speech --- (gratis 500 mil caracteres/mes)
# Crie um recurso "Speech" no Azure; pegue a Key e a Regiao (ex.: brazilsouth)
# Vozes pt-BR: pt-BR-FranciscaNeural | pt-BR-AntonioNeural | pt-BR-ThalitaNeural (confira a lista atual)
AZURE_SPEECH_KEY=
AZURE_REGION=brazilsouth
AZURE_VOICE=pt-BR-FranciscaNeural

# --- Amazon Polly --- (gratis 1 milhao de caracteres/mes neural, no 1o ano)
# Voz Camila (pt-BR). Engine: neural (amplo) ou generative (so em eu-west-2, ca-central-1, eu-central-2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
POLLY_VOICE=Camila
POLLY_ENGINE=neural
